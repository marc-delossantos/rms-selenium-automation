async function IT_022() {
    let driver;
    try {
        driver = await new Builder().forBrowser('chrome').build();
        await driver.manage().window().maximize();

        await login(driver);

        const sideMenuIA = await driver.findElement(sideMenu.resourceAlloc);
        await sideMenuIA.click();

        // Wait for Resource Allocation page
        await driver.wait(until.urlContains('resource-allocation'), 10000);

        const actionBtn = await driver.findElement(RPM_ResAlloc.BTN.actionBtn);
        await actionBtn.click();

        const atssProfile = await driver.wait(
            until.elementLocated(RPM_ResAlloc.BTN.ATSSProfileOpt),
            5000
        );

        // Store original tab BEFORE click
        const originalWindow = await driver.getWindowHandle();

        await atssProfile.click();

        // Wait for new tab
        await driver.wait(async () => {
            const handles = await driver.getAllWindowHandles();
            return handles.length > 1;
        }, 10000);

        // Switch to new tab
        const handles = await driver.getAllWindowHandles();
        for (let handle of handles) {
            if (handle !== originalWindow) {
                await driver.switchTo().window(handle);
                break;
            }
        }

        // Wait for ATSS page to load
        await driver.wait(
            until.urlContains('https://atss.awsys-i.com/'),
            10000
        );

        console.log("Switched to ATSS tab");

        // Close ATSS tab
        await driver.close();

        // Switch back to original tab
        await driver.switchTo().window(originalWindow);

        console.log("Returned to original tab");

        const screenshotPath = await takeScreenshot(driver, 'test_022');
        await writeResult('RPM:ResAlloc_test_IT_022', 'PASS', screenshotPath);

    } catch (error) {
        console.error('test failed:', error.message);

