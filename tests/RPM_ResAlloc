async function IT_004() {
      let driver;
    try {
        driver = await new Builder().forBrowser('chrome').build();
        await driver.manage().window().maximize();

        await login(driver); //go login

        const sideMenuIA = await driver.findElement(sideMenu.resourceAlloc);
        await sideMenuIA.click();

        // --- Wait for Resource & Project Management/Resource Allocation
        await driver.wait(until.urlContains('resource-allocation'), 10000); //wait for screen to load
        await driver.sleep(1000);

        const search = await driver.findElement(RPM_ResAlloc.searchBox);
        await search.clear();
        await search.sendKeys(data.searchSampData.searchKeyword1);

        //assert
        await driver.wait(until.elementsLocated(RPM_ResAlloc.tableColumns), 10000);
        let rows = await driver.findElements(RPM_ResAlloc.tableColumns);
        let matchFound = false;

        for (let row of rows) {
            let nameCell = await row.findElement(RPM_ResAlloc.tableName);
            let cellText = await nameCell.getText();

            if (cellText.includes(keyword)) {
                matchFound = true;
                break;
            }
        }
        assert.ok(matchFound, `No table row contains the keyword: ${keyword}`);
        console.log("Keyword found in table!");

        const screenshotPath = await takeScreenshot(driver, 'test_004');
        await writeResult('RPM:ResAlloc_test_IT_004', 'PASS', screenshotPath);
        
    } catch (error) {
        console.error('test failed:', error.message);
        let screenshotPath;
        if (driver) {
            screenshotPath = await takeScreenshot(driver, 'test_004');
            await writeResult('RPM:ResAlloc_test_IT_004', 'FAILED', screenshotPath, error.message); // <-- Include screenshot for FAIL
        }
    }finally {
        if (driver) {
            await driver.sleep(3000);
            await driver.quit();
        }
    }
}

